# Copy to .env (git-ignored) and fill in. Generate secrets with:
#   openssl rand -hex 32
# See docs/security.md for what each credential grants.

# --- ClickHouse -------------------------------------------------------------
# Admin account (importer, maintenance scripts). Local/compose network only.
CLICKHOUSE_PASSWORD=
# Least-privilege accounts, created by ./scripts/setup-clickhouse-users.sh
CLICKHOUSE_API_USER=tracker_api
CLICKHOUSE_API_PASSWORD=
CLICKHOUSE_SESSION_READONLY=false
CLICKHOUSE_INGEST_USER=tracker_ingest
CLICKHOUSE_INGEST_PASSWORD=

# --- Postgres (housekeeping state) -----------------------------------------
# Only applied when the volume is first created; changing it later needs
# ALTER USER housekeeping PASSWORD '...' inside the container.
POSTGRES_PASSWORD=

# --- Housekeeping access ---------------------------------------------------
# Unlocks housekeeping changes (browser "unlock changes", backup, ingest).
HK_OPERATOR_KEY=
# Executor receipt uploads; same value in ~/.hk_exec_token on the cluster.
HK_EXEC_TOKEN=

# --- Login gate / features --------------------------------------------------
# Extra usernames allowed at the gate besides the RCC group members.
ALLOWED_USERS=
# NL-to-SQL (Groq). Questions are sent to Groq; leave empty to disable.
GROQ_API_KEY=

# --- Off-site backups (Cloudflare R2, optional) -----------------------------
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
